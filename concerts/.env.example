# All optional. Official venue calendars work without these keys.
TICKETMASTER_API_KEY=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match the callback registered in Spotify's dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4317/api/concerts?action=spotify-callback
APP_ORIGIN=http://127.0.0.1:4317
# Use a dedicated Redis database for a cloud deployment. Local dev uses .data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=
PORT=4317
