{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/concerts.mjs": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/share.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@fontsource/inter/files/**"
    }
  },
  "headers": [
    {
      "source": "/concerts/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/concerts",
      "destination": "/concerts/index.html"
    }
  ]
}
