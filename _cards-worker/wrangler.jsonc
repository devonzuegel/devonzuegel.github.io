{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devon-cards",
  "account_id": "c8bebf69ef232f4416601de728137fc8",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cards-api.devonzuegel.com", "custom_domain": true }],
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "devon-cards", "database_id": "b4ab45f6-33eb-4b5f-bf68-76e6eb9b4cfa", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "6979755031", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "DASHBOARD_ORIGIN": "https://devonzuegel.com",
    "PUBLIC_ORIGIN": "https://cards-api.devonzuegel.com",
    "OWNER_GITHUB_ID": "6979755",
    "GITHUB_CLIENT_ID": "Ov23litovFbX3S08jQcp",
    "NOTION_DATA_SOURCE": "7c583d6a-698c-470d-8d1e-86f269d502fd",
    "VAPID_SUBJECT": "https://devonzuegel.com/remember/"
  }
}
