{
  "name": "devon-qr-codes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "migrate:local": "wrangler d1 migrations apply qr-codes-local --local --config wrangler.local.jsonc",
    "deploy": "node scripts/check-config.mjs && wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir .build/worker"
  },
  "dependencies": {
    "qr": "0.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@playwright/test": "1.58.2",
    "esbuild": "0.25.12",
    "jsqr": "1.4.0",
    "miniflare": "5.20260923.0-alpha",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "wrangler": "4.139.0"
  }
}
